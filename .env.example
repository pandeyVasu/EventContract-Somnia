# Copy to .env and fill in. NEVER commit .env or any key file.
#
# Two audiences here:
#   - the headless scripts in spike/, which sign with a private key and read the
#     plain names below;
#   - the browser app, which signs with the player's own wallet and therefore
#     needs no key at all. Vite only exposes names beginning with VITE_, so the
#     app reads the VITE_-prefixed copies.
#
# Every value below is optional except PRIVATE_KEY, and only spike/ needs that.
# Leave the rest unset to use the public Shannon testnet defaults baked in as
# fallbacks; set them to point at another network or your own indexer.

# --- spike/ only -------------------------------------------------------------

# A funded Shannon testnet key, used only to sign your own transactions locally.
# Testnet only. Never reuse a key that holds anything real.
PRIVATE_KEY=0x...

# --- network endpoints -------------------------------------------------------
# Somnia Shannon testnet, chain 50312. The defaults below are the public
# endpoints published in the @somnia-chain/markets-sdk README and pre-filled by
# the dreamDEX Event Contracts starter template. The SDK requires an indexer URL
# at construction even though every read and write here is on chain.

RPC_URL=https://dream-rpc.somnia.network
WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
INDEXER_URL=https://dev.smk.somnia.host/v1/graphql

# The same two, for the browser app. Set these only if you changed the ones
# above; they are read at build time, not at run time.
# VITE_WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
# VITE_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
